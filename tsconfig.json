{
	"compilerOptions": {
		"declaration": true,
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ESNext", "DOM"],
		"skipLibCheck": true,
		"strict": true,
		"noImplicitAny": false,
		"esModuleInterop": true,
		"declarationMap": true,
		"outDir": "dist/types",
		"rootDir": "./src",
		"emitDeclarationOnly": true
	},
	"include": ["src/**/*", "types/**/*"]
}
